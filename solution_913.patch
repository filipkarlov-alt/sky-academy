diff --git a/src/game/parents.ts b/src/game/parents.ts
--- a/src/game/parents.ts
+++ b/src/game/parents.ts
@@ -68,6 +68,16 @@ export function parentSummary(user: User): ParentSummary {
     },
   };
 
+  const trophyLessTopics = user.progress.filter(
+    (progress) => !progress.sprint.trophy && progress.sprint.year === currentYear
+  ).map((progress) => progress.sprint.topic);
+
+  if (trophyLessTopics.length > 0) {
+    summary.topics.push({
+      title: "Topics without a Sprint trophy yet",
+      topics: trophyLessTopics,
+    });
+  }
+
   return summary;
 }
 
